`),a=r*.005859375;var o=new Uint8Array(32),s=new TextEncoder().encode(i);let c=(0,Ho.default)(o.length).update(s).digest().join(``).split(``).map(e=>parseInt(e)),l=[],u=Io(0,6),d=0;for(let e=0;e<c.length;e++){let t=c[e];t===0?d<u&&(l.push(t),d++):l.push(t)}let f=[];for(let e=0;e<60;e++){let i=l[e],o,s;t?(o=360-.1*1+i*.4,i==0?s=310-Io(10,-20):(s=170-35*i+Io(20,-30),s<10&&(s=Io(20,30)))):(s=3-.1*1+i*.4,i==0?o=50+Io(-10,20):(o=190+17*i+Io(-20,60),o>350&&(o=Io(330,340)))),f.push(Ro(n[0]/2,n[1]/2,r-e*a,s,o,t?80:-130,!1))}return{poem:i,hash:c,arcs:f,lineWidth:a}}var Ho,Uo=o((()=>{wo(),Ho=l(Fo())})),Wo,Go,Ko,qo,Jo,Yo,Xo=o((()=>{So(),wo(),Uo(),Wo={id:`enso`},Go={id:`svgenso`,viewBox:`0 0 2048 2048`,xmlns:`http://www.w3.org/2000/svg`},Ko=[`stroke-width`,`d`],qo={key:0,x:`2028`,y:`2028`,color:`black`,"text-anchor":`end`,"font-size":`40`,id:`svgsource`,"font-family":`Arnold, sans-serif`},Jo={key:0,id:`source`},Yo=On({__name:`Enso`,props:{poemData:{type:Object,required:!0},sourceStyle:{type:String,default:Co.STANDARD},reverse:{type:Boolean,required:!0,default:!1}},setup(e){let t=e,n=ha(()=>zo(t.poemData,t.sourceStyle)),r=ha(()=>Vo(t.poemData,t.reverse));return(t,i)=>(K(),kr(`div`,Wo,[(K(),kr(`svg`,Go,[i[0]||=q(`rect`,{width:`100%`,height:`100%`,fill:`#e8e3df`},null,-1),(K(!0),kr(Z,null,zn(r.value.arcs,(e,t)=>(K(),kr(`path`,{key:`arc`+t,fill:`none`,stroke:`#000000`,"stroke-width":r.value.lineWidth+1,d:e,"stroke-linecap":`round`,"shape-rendering":`geometricPrecision`},null,8,Ko))),128)),e.sourceStyle==dt(Co).NO_SOURCE?Lr(``,!0):(K(),kr(`text`,qo,L(n.value),1))])),e.sourceStyle==dt(Co).NO_SOURCE?Lr(``,!0):(K(),kr(`div`,Jo,L(n.value),1))]))}})})),Zo=o((()=>{})),Qo,$o=o((()=>{Xo(),Xo(),Zo(),Qo=Yo}));function es(){return JSON.parse(JSON.stringify(ts[Math.floor(Math.random()*ts.length)]))}var ts,ns=o((()=>{ts=[{title:``,author:`Han Shan`,content:`I STAND here and watch the people of this world:
all against one and one against all,
angry, arguing, plotting and scheming.
Then one day, suddenly, they die.
And each gets one plot of ground:
four feet wide, six feet long.
If you can scheme your way out of that plot,
I’ll set the stone that immortalizes your name`},{title:``,author:`Han Shan`,content:`I laugh at what he calls poetry: a blind man’s
rhymes in lukewarm praise of the sun.`},{title:``,author:`Han Shan`,content:`MY heart’s like the autumn moon,
reflecting from the clear pure waters of the pool.
There’s nothing to compare:What can I say?`},{title:``,author:`Han Shan`,content:`EAST of me, the old lady
Got rich three or four years ago.
Used to be poorer than me,
Now she laughs that I don’t have money.
She laughs that I’ve fallen behind.
I laugh that she’s gotten ahead.
Both of us laughing, no stopping us.
East, and West.`},{title:`Shih Te`,author:`Han Shan`,content:`MY poems are poems;
some people call them sermons.
Well, poems and sermons share one thing:
when you read them you’ve got to be careful.
Keep at it. Get into detail.
Don’t just claim they’re easy.
If you were to live your life like that,
a lot of funny things might happen.`},{title:``,author:`Li Po`,content:`Zazen on Ching-t’ing Mountain
THE birds have vanished from the sky.
Now the last cloud drains away.
We sit together, the mountain and me,
until only the mountain remains.`},{title:`To Magistrate Chang`,author:`Wang Wei`,content:`LATE, I love but quietness:
things of this world are no more my concern.
Looking back, I’ve known no better plan
than this: returning to the grove.
Pine breezes loosen my robe.
Mountain moonbeams play my lute.
What, you ask, is Final Truth?
The fisherman’s song strikes deep into the bank.`},{title:`Inscribed on the Wall of the Hut by the Lake`,author:`Chiao Jan`,content:`IF you want to be a mountain-dweller . . .
no need to trek to India to find one.
I have a thousand peaks
to pick from right here on the lake.
Fragrant grasses and white cloudshold me here.
What holds you there,
world-dweller?`},{title:`After Reading Lao Tzu`,author:`Po Chu-i`,content:`“ONE who speaks does not know; one who knows does not speak.”
Thus I have been instructed by the Old Master.
If you tell me the Old Master was one who knew, I ask,
Why did he write five thousand words to explain it?`},{title:`Parting with the Monk Ho-lan`,author:`Wu Pen (Chia Tao)`,content:`WILD monk, come to make a parting with me.
We sit a while on the sand beside the welling source.
You’ll go a long way on that empty alms bowl,
deep among mountains, treading fallen flowers.
Masterless Ch’an, our own understanding?
When you’ve got it, there’s no place for it but a poem.
This parting’s nothing fated:
orphan clouds just never settle down.`},{title:`The Swordsman`,author:`Wu Pen (Chia Tao)`,content:`TEN long years I’ve honed this sword:
its frost white blade is yet untried.
Today, like any other gentleman,
it’s looking for injustice.`},{title:``,author:`Anonymous Sung Dynasty Nun`,content:`SEARCHING for spring all day, I never saw it,
straw sandals treading everywhere
among the clouds, along the bank.
Coming home, I laughed, catching
the plum blossom’s scent:
spring at each branch tip, already perfect.`},{title:`Written to the Tune of “An Immortal Approaching the River”`,author:`Su Tung-p’o`,content:`WINE at East Bank tonight, sobered up
then started over, getting drunk again.
Got home, a little fuzzy, maybe close to three,
and the houseboy was snoring like thunder.
I knocked at my gate, but nobody answered.
I leaned on my cane and listened to the river.
I hate it!—that even this body’s not mine alone . . .
Someday I’ll give it all up.
The night moves, the breeze writes
quietly in ripples on the water.
A little boat, leaving here and now,
the rest of my life on the river, on the sea.`},{title:`Wandering Late at Kulin Temple`,author:`Yuan Mei`,content:`THE single sound of the bell
brings out the whole hall’s monks.
Golden glint of the Buddha’s face
almost the flash of a lamp.
The bodhisattva Dragon Tree is silent,
the wind has died away . . .
The robes of the monks cast shadows
as the moon begins to rise.
No need to chant to sutrasto make the flowers giggle . . .
As I lean and listen carefully,
even the stones respond.
How can the Buddha, King of Emptiness,
boast of setting the whole world free?
Here, when spring comes,
he hasn’t freed even half this pond
from thinking long on love.`},{title:`On the Road to T’ien-t’ai`,author:`Yuan Mei`,content:`WRAPPED, surrounded by ten thousand mountains,
cut off, no place to go . . .
Until you’re here, there’s no way to get here.
Once you’re here, there’s no way to go.`},{title:``,author:`Saigyō`,content:`I’D like to divide
myself in order to see,
among these mountains,
each and every flower
of every cherry tree`},{title:``,author:`Saigyō`,content:`THIS loneliness is
not simply the result
of autumn colors—
even mountain evergreens make
me feel like autumn evening`},{title:``,author:`Fujiwara no Ietaka`,content:`EVERYTHING must end.
Thus the day tries to begin
with the morning bell.
But the long night remains,
empty moon still in the sky.`},{title:``,author:`The Priest Jakuren`,content:`CALL it loneliness,
that deep, beautiful color
no one can describe:
over these dark mountains,
the gathering autumn dusk.`},{title:``,author:`Asukai Masatsune`,content:`I WALKED among stones
through mountains of mountains,
paying no mind
until the flower-trail behind
turned into drifting white clouds.`},{title:``,author:`Dōgen Kigen`,content:`EVEN without hearts
and minds, plants wither
with the passing days.
Seeing just how this is so,
we feel a little ashamed.`},{title:``,author:`Dōgen Kigen`,content:`CAST away all speech.
Our words may express it,
but cannot hold it.
The way of letters leaves no trace,
yet the teaching is revealed.`},{title:``,author:`Kōhō Kennichi`,content:`HERE in a thatched hut
hidden among mountain peaks,
with barely room for one,
I’m suddenly invaded
by wandering white clouds.`},{title:``,author:`Emperor Fushima`,content:`ONLY now I know
that power—greater than storms—
a heart-rending awe
silencing all the pine
sat nightfall on the mountain.`},{title:``,author:`Ikkyū Sōjun`,content:`LIKE vanishing dew,
a passing apparition
or the sudden flash
of lightning—already gone—
thus should one regard one’s self.`},{title:``,author:`Ikkyū Sōjun`,content:`AND what is mind
and how is it recognized?
It is clearly drawn
in sumi ink, the sound
of breezes drifting through pine.`},{title:`Face-to-Face with My Lover on Daitō’s Anniversary`,author:`Ikkyū Sōjun`,content:`MONKS recite the sutras in honor of the founder,
their many voices cacophonous in my ear.
Afterward, making love, our intimate whispers
mock the empty formal discipline of others.`},{title:`Elegy`,author:`Ikkyū Sōjun`,content:`WE first lay down among flowers
ten years ago and found a timeless rapture.
Sadly, I remember being pillowed by her lap,
all-night love, all eternity in our vows.`},{title:``,author:`Anonymous`,content:`TO learn how to die,
watch cherry blossoms, observe
chrysanthemums.`},{title:``,author:`Buson`,content:`IN a bitter wind
a solitary monk bends
to words cut in stone.`},{title:``,author:`Ryōkan`,content:`WHO says my poems are poems?
They aren’t poems at all.
Only when you understand my poems aren’t poems
can we talk poetry.`},{title:`Poem in Four Characters`,author:`Ryōkan`,content:`ABOVE heaven
big winds`},{title:``,author:`Ryōkan`,content:`I NEVER longed for the wilder side of life.
Rivers and mountains were my friends.
Clouds consumed my shadow where I roamed,
and birds pass high above my resting place.
Straw sandals in snowy villages,
a walking stick in spring,
I sought a timeless truth: the flowers’ glory
is just another form of dust.`},{title:``,author:`Ryōkan`,content:`YOU stop to point at the moon in the sky,
but the finger’s blind unless the moon is shining.
One moon, one careless finger pointing—
are these two things or one?
The question is a pointer guiding
a novice from ignorance thick as fog.
Look deeper. The mystery calls and calls:
No moon, no finger—nothing there at all.`},{title:``,author:`Kobayashi Issa`,content:`This world of dew
is only the world of dew—
and yet . . . and yet . . .`},{title:``,author:`Matsuo Bashō`,content:`Matsushima ya
ah Matsushima ya
Matsushima ya`},{title:``,author:`Matsuo Bashō`,content:`To have blue irises
blooming on one’s feet—
walking-sandal straps`},{title:``,author:`Matsuo Bashō`,content:`Summer grasses:
all that remains of great soldiers’
imperial dreams`},{title:``,author:`Matsuo Bashō`,content:`The winds that blow
through South Valley Temple
are sweetened by snow`},{title:``,author:`Matsuo Bashō`,content:`Pitifully—under
a great soldier’s empty helmet,
a cricket sings`},{title:``,author:`Matsuo Bashō`,content:`Sweep the garden—
all kindnesses falling
willow leaves repay`},{title:``,author:`Matsuo Bashō`,content:`If I took it in hand,
it would melt in my hot tears—
heavy autumn frost`},{title:``,author:`Matsuo Bashō`,content:`With clear melting dew,
I’d try to wash away the dust
of this floating world`},{title:``,author:`Matsuo Bashō`,content:`Karasaki’s pine,
compared to blossoming cherry,
looks a bit hazy`},{title:``,author:`Matsuo Bashō`,content:`While we’ve lived our lives
they’ve survived to still blossom,
these old cherry trees`},{title:``,author:`Matsuo Bashō`,content:`Moved to tears by
finding my umbilical cord—
the year concludes`},{title:``,author:`Matsuo Bashō`,content:`A world of memory
returns to me when I see
blossoming cherries`},{title:``,author:`Matsuo Bashō`,content:`Mile after mile
falls away each day I search
for cherry blossoms",

Blossoming cherries,
a gloomy sky, and, sadly,
one arborvitae
My fan for a cup,
I drink from a downpour
of cherry blossoms.  `},{title:``,author:`Matsuo Bashō`,content:`New Year’s first snow—ah—
just barely enough to tilt
the daffodil`},{title:``,author:`Matsuo Bashō`,content:`Now spring has arrived
on a mountain with no name
in early morning haze`},{title:``,author:`Matsuo Bashō`,content:`All hundred thousand
homes in Kyoto empty—
cherry blossom time`},{title:``,author:`Matsuo Bashō`,content:`Flowers are best seen
by the eyes of poor people—
devilish thistle!`},{title:``,author:`Matsuo Bashō`,content:`Between our two lives
there is also the life of
the cherry blossom`},{title:``,author:`Matsuo Bashō`,content:`Flitting butterflies
in the middle of a field—
sunlit shadows`},{title:``,author:`Matsuo Bashō`,content:`Saigyō’s hermitage
must be hidden somewhere in
this blossoming garden`},{title:``,author:`Matsuo Bashō`,content:`At breaking sunrise,
glistening whitefish—an inch
of utter whiteness`},{title:``,author:`Matsuo Bashō`,content:`Live the lonely life!
Sing the Lonely Moon-Watcher’s
songs of Nara`},{title:``,author:`Matsuo Bashō`,content:`On a bare branch,
a solitary crow—
autumn evening`},{title:``,author:`Matsuo Bashō`,content:`Old spider, what is
your song, how do you cry
in the autumn wind?`},{title:``,author:`Matsuo Bashō`,content:`At the ancient pond
a frog plunges into
the sound of water`},{title:``,author:`Matsuo Bashō`,content:`Now I see her face,
the old woman, abandoned,
the moon her only companion`},{title:``,author:`Matsuo Bashō`,content:`Nothing in the cry
of cicadas suggests they
are about to die`},{title:``,author:`Matsuo Bashō`,content:`Seen in bright daylight,
its neck is burning red,
this little firefly!`},{title:``,author:`Matsuo Bashō`,content:`On a white poppy,
a butterfly’s torn wing
is a keepsake`},{title:``,author:`Matsuo Bashō`,content:`With a warbler for
a soul, it sleeps peacefully,
this mountain willow`},{title:``,author:`Matsuo Bashō`,content:`I slept at a temple—
and now with such seriousness
I watch the moon`},{title:``,author:`Matsuo Bashō`,content:`I’d like to be drunk
and sleep among blooming pinks
on a cool stone`},{title:``,author:`Matsuo Bashō`,content:`Crossing long fields,
frozen in its saddle,
my shadow creeps by`},{title:``,author:`Matsuo Bashō`,content:`The morning glories
ignore our drinking party
and burst into bloom`},{title:``,author:`Matsuo Bashō`,content:`Old morning glory,
even you, as it turns out,
cannot be my friend`},{title:``,author:`Matsuo Bashō`,content:`A traveler’s heart
is what you should emulate,
pasania bloom`},{title:``,author:`Matsuo Bashō`,content:`Grass for a pillow,
the traveler knows best how
to see cherry blossoms`},{title:``,author:`Matsuo Bashō`,content:`Wake up! Wake up!
Then we’ll become good friends,
sleeping butterfly`},{title:``,author:`Matsuo Bashō`,content:`Lonely stillness—
a single cicada’s cry
sinking into stone`},{title:``,author:`Matsuo Bashō`,content:`The oak’s nobility—
indifferent to flowers—
or so it appears`},{title:``,author:`Matsuo Bashō`,content:`A wanderer,
so let that be my name—
the first winter rain`},{title:``,author:`Matsuo Bashō`,content:`All along this road
not a single soul—only
autumn evening`},{title:``,author:`Matsuo Bashō`,content:`Why just this autumn
have I grown suddenly old—
a bird in the clouds`},{title:``,author:`Matsuo Bashō`,content:`Rested from your journey,
now you’ll understand my haiku,
old autumn wind`},{title:``,author:`Matsuo Bashō`,content:`Tremble, oh my grave—
in time my cries will be
only this autumn wind`},{title:``,author:`Matsuo Bashō`,content:`Your song caresses
the depths of loneliness,
high mountain bird`},{title:``,author:`Matsuo Bashō`,content:`The whole household—
each with white hair and cane—
visiting a grave`},{title:``,author:`Matsuo Bashō`,content:`With plum blossom scent,
this morning sun emerges
along a mountain trail`},{title:`Bashō’s Death Poem`,author:`Matsuo Bashō`,content:`Sick on my journey,
only my dreams will wander
these desolate moors`},{title:``,author:`Kobayashi Issa`,content:`Even with insects—
some can sing,
    some can’t.`},{title:`On a branch...`,author:`Kobayashi Issa`,content:`On a branch
floating downriver
a cricket, singing.`},{title:``,author:`Kobayashi Issa`,content:`The snow is melting
and the village is flooded
      with children.`},{title:``,author:`Kobayashi Issa`,content:`Goes out,
comes back—
      the love life of a cat.`},{title:``,author:`Kobayashi Issa`,content:`Under the evening moon
the snail
      is stripped to the waist.`},{title:``,author:`Kobayashi Issa`,content:`Mosquito at my ear—
does he think
      I’m deaf?`},{title:``,author:`Nāgārjuna`,content:`One who does not grasp onto “I” and “mine,” 
That one does not exist. 
One who does not grasp onto “I” and “mine,” 
He does not perceive.`},{title:``,author:`Nāgārjuna`,content:`Whatever is the essence of the Tathāgata, 
That is the essence of the world. 
The Tathāgata has no essence. 
The world is without essence.`},{title:`Meditations (Notebook 10)`,author:`Marcus Aurelius`,content:`My soul,
will you ever be good,
simple, single, and naked,
brighter than the body
that encases you?`},{title:``,author:`Fernando Pessoa`,content:`Let us absurdify life from east to west.`},{title:``,author:`Fernando Pessoa`,content:`For me, possession is an absurd lake —
very large, very dark and rather shallow.
It only seems deep because it’s full of filth and lies.`},{title:``,author:`Fernando Pessoa`,content:`Life gets in the way of being able to express life.
If I were to experience a great love,
I would never be able to describe it.`},{title:``,author:`Fernando Pessoa`,content:`Become an absurd sphinx in the eyes of others.
Shut yourself up in your ivory tower,
but without slamming the door,
for your ivory tower is you.`},{title:``,author:`Fernando Pessoa`,content:`To be is to be free.`},{title:``,author:`Bertrand Russell`,content:`The good life is one inspired by love and guided by knowledge.`}]})),rs=s(((e,t)=>{(function(e){var n=y(),r=b(),i=x(),a=S(),o={imagePlaceholder:void 0,cacheBust:!1},s={toSvg:c,toPng:u,toJpeg:d,toBlob:f,toPixelData:l,impl:{fontFaces:i,images:a,util:n,inliner:r,options:{}}};t===void 0?e.domtoimage=s:t.exports=s;function c(e,t){return t||={},p(t),Promise.resolve(e).then(function(e){return h(e,t.filter,!0)}).then(g).then(_).then(r).then(function(r){return v(r,t.width||n.width(e),t.height||n.height(e))});function r(e){return t.bgcolor&&(e.style.backgroundColor=t.bgcolor),t.width&&(e.style.width=t.width+`px`),t.height&&(e.style.height=t.height+`px`),t.style&&Object.keys(t.style).forEach(function(n){e.style[n]=t.style[n]}),e}}function l(e,t){return m(e,t||{}).then(function(t){return t.getContext(`2d`).getImageData(0,0,n.width(e),n.height(e)).data})}function u(e,t){return m(e,t||{}).then(function(e){return e.toDataURL()})}function d(e,t){return t||={},m(e,t).then(function(e){return e.toDataURL(`image/jpeg`,t.quality||1)})}function f(e,t){return m(e,t||{}).then(n.canvasToBlob)}function p(e){e.imagePlaceholder===void 0?s.impl.options.imagePlaceholder=o.imagePlaceholder:s.impl.options.imagePlaceholder=e.imagePlaceholder,e.cacheBust===void 0?s.impl.options.cacheBust=o.cacheBust:s.impl.options.cacheBust=e.cacheBust}function m(e,t){return c(e,t).then(n.makeImage).then(n.delay(100)).then(function(t){var n=r(e);return n.getContext(`2d`).drawImage(t,0,0),n});function r(e){var r=document.createElement(`canvas`);if(r.width=t.width||n.width(e),r.height=t.height||n.height(e),t.bgcolor){var i=r.getContext(`2d`);i.fillStyle=t.bgcolor,i.fillRect(0,0,r.width,r.height)}return r}}function h(e,t,r){if(!r&&t&&!t(e))return Promise.resolve();return Promise.resolve(e).then(i).then(function(n){return a(e,n,t)}).then(function(t){return o(e,t)});function i(e){